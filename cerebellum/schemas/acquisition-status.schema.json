    },
    "dead_letter_jobs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "document_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "enabled_sources": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "knowledge_card_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
