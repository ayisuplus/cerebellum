{
  "$defs": {
    "BaseModelPin": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "revision",
        "sha256"
      ],
      "type": "object"
    },
    "ExpertTrainingPlan": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "$ref": "#/$defs/TrainingArchitecture"
        },
        "expert_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expert_view_id": {
          "format": "uuid",
          "type": "string"
        },
        "fallback_expert_id": {
          "type": "string"
        },
        "router_top_k": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "train_router": {
          "type": "boolean"
        },
        "train_shared": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "architecture",
        "expert_view_id",
        "train_router",
        "expert_ids",
        "router_top_k",
        "fallback_expert_id"
      ],
      "type": "object"
    },
    "GpuLease": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "gpu_memory_gb": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gpu_spec": {
          "type": "string"
        },
        "hourly_price_cny": {
          "format": "double",
          "type": "number"
        },
        "last_heartbeat_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "last_provider_status": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "provider_instance_id": {
          "type": "string"
        },
        "release_requested_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "released_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "format": "uuid",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GpuLeaseStatus"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "provider",
        "provider_instance_id",
        "gpu_spec",
        "gpu_memory_gb",
        "hourly_price_cny",
        "status",
        "last_provider_status",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "GpuLeaseStatus": {
      "enum": [
        "provisioning",
        "waiting_worker",
        "running",
        "release_requested",
        "released",
        "release_failed"
      ],
      "type": "string"
    },
    "QloraConfig": {
      "additionalProperties": false,
      "properties": {
        "epochs": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "gradient_accumulation_steps": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "learning_rate": {
          "format": "double",
          "type": "number"
        },
        "lora_alpha": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "lora_dropout": {
          "format": "double",
          "type": "number"
        },
        "lora_rank": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "max_sequence_length": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "epochs",
        "max_sequence_length",
        "lora_rank",
        "lora_alpha",
        "lora_dropout",
        "learning_rate",
        "gradient_accumulation_steps"
      ],
      "type": "object"
    },
    "TrainingArchitecture": {
      "enum": [
        "dense_lora",
        "routed_lora"
      ],
      "type": "string"
    },
    "TrainingBudget": {
      "additionalProperties": false,
      "properties": {
        "max_hourly_cny": {
          "format": "double",
          "type": "number"
        },
        "max_total_cny": {
          "format": "double",
          "type": "number"
        },
        "max_wall_seconds": {
          "default": 21600,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_hourly_cny",
        "max_total_cny"
      ],
      "type": "object"
    },
    "TrainingRun": {
      "additionalProperties": false,
      "properties": {
        "administrator": {
          "type": "string"
        },
        "application_uuid": {
          "type": "string"
        },
        "application_version": {
          "type": "string"
        },
        "artifact_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_model": {
          "$ref": "#/$defs/BaseModelPin"
        },
        "budget": {
          "$ref": "#/$defs/TrainingBudget"
        },
        "completed_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimated_cost_cny": {
          "format": "double",
          "type": "number"
        },
        "expert_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpertTrainingPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hourly_price_cny": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": "string"
        },
        "provider_instance_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "qlora": {
          "$ref": "#/$defs/QloraConfig"
        },
        "reason": {
          "type": "string"
        },
        "requested_gpu_spec": {
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "selected_gpu_spec": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot_bundle_hash": {
          "type": "string"
        },
        "snapshot_id": {
          "format": "uuid",
          "type": "string"
        },
        "snapshot_manifest_hash": {
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/TrainingRunStatus"
        },
        "training_bundle_hash": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "training_manifest_hash": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "snapshot_id",
        "snapshot_bundle_hash",
        "snapshot_manifest_hash",
        "base_model",
        "qlora",
        "provider",
        "application_uuid",
        "application_version",
        "requested_gpu_spec",
        "administrator",
        "reason",
        "budget",
        "status",
        "estimated_cost_cny",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "TrainingRunEvent": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "payload": true,
        "run_id": {
          "format": "uuid",
          "type": "string"
        },
        "sequence": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "run_id",
        "kind",
        "payload",
        "created_at"
      ],
      "type": "object"
    },
    "TrainingRunStatus": {
      "enum": [
        "requested",
        "provisioning",
        "waiting_capacity",
        "waiting_worker",
        "running",
        "uploading",
        "completed",
        "failed",
        "cancelled",
        "timed_out"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "events": {
      "items": {
        "$ref": "#/$defs/TrainingRunEvent"
      },
      "type": "array"
    },
    "lease": {
      "anyOf": [
        {
          "$ref": "#/$defs/GpuLease"
        },
        {
          "type": "null"
        }
      ]
    },
    "run": {
      "$ref": "#/$defs/TrainingRun"
    }
  },
  "required": [
    "run",
    "events"
  ],
  "title": "TrainingRunDetail",
  "type": "object"
}
