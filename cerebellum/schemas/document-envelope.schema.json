{
  "$defs": {
    "AcquisitionMethod": {
      "enum": [
        "api",
        "rss",
        "direct_http",
        "crawl4ai",
        "firecrawl",
        "link_mapper",
        "scrapling",
        "mediacrawler",
        "open_cli"
      ],
      "type": "string"
    },
    "DocumentRights": {
      "additionalProperties": false,
      "properties": {
        "explicit_training_permission": {
          "type": "boolean"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_terms_allow_training": {
          "type": "boolean"
        },
        "redistribution_allowed": {
          "type": "boolean"
        },
        "retrieval_allowed": {
          "type": "boolean"
        },
        "rights_source": {
          "type": "string"
        },
        "storage_allowed": {
          "type": "boolean"
        },
        "training_eligible": {
          "type": "boolean"
        }
      },
      "required": [
        "retrieval_allowed",
        "storage_allowed",
        "redistribution_allowed",
        "explicit_training_permission",
        "model_terms_allow_training",
        "training_eligible",
        "rights_source"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_url": {
      "type": "string"
    },
    "cleaned_content_hash": {
      "type": "string"
    },
    "content_type": {
      "type": "string"
    },
    "document_id": {
      "format": "uuid",
      "type": "string"
    },
    "external_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "extraction_method": {
      "$ref": "#/$defs/AcquisitionMethod"
    },
    "extractor_version": {
      "type": "string"
    },
    "fetched_at": {
      "format": "date-time",
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "metadata": {
      "default": null
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "pii_detected": {
      "type": "boolean"
    },
    "prompt_injection_detected": {
      "type": "boolean"
    },
    "published_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "raw_content_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "rights": {
      "$ref": "#/$defs/DocumentRights"
    },
    "schema_version": {
      "type": "string"
    },
    "secret_detected": {
      "type": "boolean"
    },
    "source_policy_id": {
      "format": "uuid",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "tombstoned": {
      "type": "boolean"
    },
    "topic_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "type": "array"
    },
    "url": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "topic_ids",
    "source_policy_id",
    "url",
    "canonical_url",
    "title",
    "observed_at",
    "fetched_at",
    "cleaned_content_hash",
    "extraction_method",
    "extractor_version",
    "language",
    "content_type",
    "rights",
    "prompt_injection_detected",
    "pii_detected",
    "secret_detected",
    "raw_expires_at",
    "tombstoned"
  ],
  "title": "DocumentEnvelope",
  "type": "object"
}
