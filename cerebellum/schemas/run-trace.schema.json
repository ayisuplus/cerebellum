{
  "$defs": {
    "CompleteRunRequest": {
      "additionalProperties": false,
      "properties": {
        "experience": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunCompletionExperience"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metrics": {
          "default": null
        },
        "outcome": {
          "type": "string"
        },
        "summary": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "outcome"
      ],
      "type": "object"
    },
    "DataClassification": {
      "enum": [
        "public",
        "internal",
        "private"
      ],
      "type": "string"
    },
    "ExperienceCost": {
      "additionalProperties": false,
      "properties": {
        "estimated_usd": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "wall_time_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ExperienceSource": {
      "additionalProperties": false,
      "properties": {
        "collected_by": {
          "default": "",
          "type": "string"
        },
        "commit_sha": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ExperienceSourceKind"
        },
        "license": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri"
      ],
      "type": "object"
    },
    "ExperienceSourceKind": {
      "enum": [
        "agent_trace",
        "github",
        "simulation"
      ],
      "type": "string"
    },
    "ExternalProcessingPermission": {
      "enum": [
        "denied",
        "redacted"
      ],
      "type": "string"
    },
    "GateStatus": {
      "enum": [
        "pass",
        "deny",
        "needs_human"
      ],
      "type": "string"
    },
    "GateTrace": {
      "properties": {
        "evaluated_at": {
          "format": "date-time",
          "type": "string"
        },
        "evidence": true,
        "gate_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GateStatus"
        }
      },
      "required": [
        "gate_id",
        "status",
        "reason",
        "evidence",
        "evaluated_at"
      ],
      "type": "object"
    },
    "RepositorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "type": "string"
        },
        "dirty": {
          "default": false,
          "type": "boolean"
        },
        "repository_id": {
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "digest"
      ],
      "type": "object"
    },
    "RunCompletionExperience": {
      "additionalProperties": false,
      "description": "Learning provenance attached to a run completion. When present, the\ndaemon closes the loop by ingesting one experience for the finished run\n(experience_id == run_id, so replays collapse instead of duplicating).",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "cost": {
          "$ref": "#/$defs/ExperienceCost",
          "default": {
            "estimated_usd": 0.0,
            "input_tokens": 0,
            "output_tokens": 0,
            "wall_time_ms": 0
          }
        },
        "data_classification": {
          "$ref": "#/$defs/DataClassification",
          "default": "private"
        },
        "external_processing": {
          "$ref": "#/$defs/ExternalProcessingPermission",
          "default": "denied"
        },
        "model_id": {
          "type": "string"
        },
        "repository": {
          "$ref": "#/$defs/RepositorySnapshot"
        },
        "source": {
          "$ref": "#/$defs/ExperienceSource"
        },
        "task": {
          "type": "string"
        },
        "task_family": {
          "type": "string"
        },
        "trajectory": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TrajectoryRef"
          },
          "type": "array"
        }
      },
      "required": [
        "task",
        "task_family",
        "repository",
        "agent_id",
        "model_id",
        "source"
      ],
      "type": "object"
    },
    "RunRecord": {
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "decision_id": {
          "format": "uuid",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "repository_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "workflow_id": {
          "type": "string"
        },
        "workflow_version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "decision_id",
        "workflow_id",
        "workflow_version",
        "capabilities",
        "status",
        "created_at"
      ],
      "type": "object"
    },
    "TraceEvent": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "payload": true,
        "sequence": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "kind",
        "payload",
        "created_at"
      ],
      "type": "object"
    },
    "TrajectoryRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "type": "string"
        },
        "media_type": {
          "default": "",
          "type": "string"
        },
        "redacted": {
          "default": false,
          "type": "boolean"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "content_hash"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "completion": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompleteRunRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "events": {
      "items": {
        "$ref": "#/$defs/TraceEvent"
      },
      "type": "array"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateTrace"
      },
      "type": "array"
    },
    "run": {
      "$ref": "#/$defs/RunRecord"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run",
    "events",
    "gates"
  ],
  "title": "RunTrace",
  "type": "object"
}
